{
  "expo": {
    "name": "Cali Valley",
    "slug": "cali-valley-studios",
    "version": "0.1.0",
    "scheme": "calivalley",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0B10",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0B10",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Cali Valley",
      "shortName": "Cali Valley",
      "themeColor": "#0D0B10",
      "backgroundColor": "#0D0B10"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0D0B10"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
